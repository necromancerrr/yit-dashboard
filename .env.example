# Copy this file to .env.local for local development
# (Docker / hosting platforms: set these as real environment variables instead.)

# Your name — drives the greeting, the nav header, the login screen, the
# page title, and the "Y" on the app icon. Not sensitive, safe to be public.
NEXT_PUBLIC_DISPLAY_NAME=Yit

# Timezone that decides when "today" rolls over — gym streaks, the activity
# heatmap, and the daily checklist reset all key off it. An IANA name such as
# America/New_York. Leave blank to use the machine's own timezone.
#
# Use this rather than TZ on Vercel: TZ is a reserved variable name there and
# cannot be set, and Vercel's functions always run in UTC.
APP_TIMEZONE=

# Required: random secret used to sign session cookies.
# Generate one with: openssl rand -base64 32
AUTH_SECRET=

# Password to sign in with. Pick ONE of the two options below.

# Option A — quick start (fine for local/self-hosted use):
APP_PASSWORD=

# Option B — recommended for anything internet-facing. Generate a hash with:
#   node scripts/hash-password.mjs "your password"
# then set the resulting hash here instead of APP_PASSWORD.
APP_PASSWORD_HASH=

# Optional: only needed if you're using a hosted libSQL/Turso database
# instead of the default local SQLite file (db/local.db).
# Get these from https://turso.tech after `turso db create` + `turso db tokens create`.
DATABASE_URL=
DATABASE_AUTH_TOKEN=

# Optional: enables screenshot import (Crypto -> Scan). Without it the feature
# reports that it is unconfigured rather than failing. Get a key at
# https://console.anthropic.com — usage is billed per image, typically a
# fraction of a cent per screenshot.
ANTHROPIC_API_KEY=

# Optional: which AI provider backs the intelligence features (currently the
# Today briefing; later, career email classification). "anthropic" is the
# default and needs ANTHROPIC_API_KEY above; "none" disables AI entirely.
# The dashboard is fully functional either way — nothing here is required.
AI_PROVIDER=

# Optional: override the model the provider uses.
AI_MODEL=

# Optional: connect a Gmail account so recruiting mail updates Career on its
# own. All three are required together; without them the app runs normally and
# the sync control simply does not appear.
#
# Create an OAuth client in Google Cloud Console, grant the read-only scope
# https://www.googleapis.com/auth/gmail.readonly, and complete the consent flow
# once to obtain a refresh token. Only message metadata and Gmail's own short
# snippet are ever fetched — never message bodies.
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=

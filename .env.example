# Copy this file to .env.local for local development
# (Docker / hosting platforms: set these as real environment variables instead.)

# Your name — drives the greeting, the nav header, the login screen, the
# page title, and the "Y" on the app icon. Not sensitive, safe to be public.
NEXT_PUBLIC_DISPLAY_NAME=Yit

# Timezone that decides when "today" rolls over — gym streaks, the activity
# heatmap, and the daily checklist reset all key off it. An IANA name such as
# America/New_York. Leave blank to use the machine's own timezone.
#
# Use this rather than TZ on Vercel: TZ is a reserved variable name there and
# cannot be set, and Vercel's functions always run in UTC.
APP_TIMEZONE=

# Required: random secret used to sign session cookies.
# Generate one with: openssl rand -base64 32
AUTH_SECRET=

# Password to sign in with. Pick ONE of the two options below.

# Option A — quick start (fine for local/self-hosted use):
APP_PASSWORD=

# Option B — recommended for anything internet-facing. Generate a hash with:
#   node scripts/hash-password.mjs "your password"
# then set the resulting hash here instead of APP_PASSWORD.
APP_PASSWORD_HASH=

# Optional: only needed if you're using a hosted libSQL/Turso database
# instead of the default local SQLite file (db/local.db).
# Get these from https://turso.tech after `turso db create` + `turso db tokens create`.
DATABASE_URL=
DATABASE_AUTH_TOKEN=
